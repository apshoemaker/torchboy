{
  "name": "cavern-game",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server.mjs",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"tools/*.mjs\" server.mjs vite.config.mjs eslint.config.mjs",
    "format:check": "prettier --check \"src/**/*.js\" \"tools/*.mjs\" server.mjs vite.config.mjs eslint.config.mjs",
    "check": "npm run lint && npm run format:check && node tools/validate_levels.mjs && vite build",
    "test": "node tools/validate_levels.mjs 300",
    "levels": "node tools/validate_levels.mjs",
    "assets": "bash tools/build_assets.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "three": "^0.180.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
